{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DbPath": "workhour.db",
  "DbProvider": "sqlite",
  "WorkSessionCleanup": {
    "Enabled": true,
    "RestoreOnStartup": true,
    "RestoreWindowDays": 0,
    "ScheduleTime": "00:00",
    "StaleThresholdHours": 8
  }
}
